# Supabase 設定
# 請到 https://supabase.com 建立專案後取得以下資訊
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key（Admin 後台用，只用於伺服器端，絕不暴露至瀏覽器）
# 在 Supabase Dashboard > Project Settings > API > service_role 取得
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google OAuth 設定
# 在 Supabase Dashboard > Authentication > Providers > Google 設定
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Admin 後台管理員 Email（用於保護 /admin 路由，僅限伺服器端）
# 設定為你自己的 Google 登入 Email
ADMIN_EMAIL=your-admin-email@gmail.com
